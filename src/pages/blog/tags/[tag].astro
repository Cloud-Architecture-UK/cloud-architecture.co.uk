---
import MainLayout from '@/layouts/MainLayout.astro';
import CardBlog from '@components/ui/cards/CardBlog.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@data/constants';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ id, data }) => id.startsWith('en/') && !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => (p.data.tags ?? []).includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
const title = tag
  .replaceAll('-', ' ')
  .replace(/\bm365\b/i, 'M365')
  .replace(/^\w/, (c) => c.toUpperCase());
const pageTitle = `${title} | Blog | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  customDescription={`Cloud Architecture posts tagged ${title}.`}
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24">
    <p
      class="mb-3 font-mono text-xs font-semibold tracking-[0.16em] text-accent uppercase"
    >
      Tag
    </p>
    <h1
      class="mb-2 text-4xl font-bold tracking-tight text-primary md:text-5xl"
    >
      {title}
    </h1>
    <p class="mb-10 text-primary">
      {posts.length} {posts.length === 1 ? 'post' : 'posts'}
    </p>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((blogEntry) => <CardBlog blogEntry={blogEntry} />)}
    </div>
    <div class="mt-12">
      <a
        href="/blog"
        class="inline-flex items-center gap-x-2 text-sm font-bold text-accent hover:underline"
        >All posts</a
      >
    </div>
  </section>
</MainLayout>
