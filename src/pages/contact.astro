---
import MainLayout from '@/layouts/MainLayout.astro';
import ContactIconBlock from '@components/ui/blocks/ContactIconBlock.astro';
import TextInput from '@components/ui/forms/input/TextInput.astro';
import EmailInput from '@components/ui/forms/input/EmailInput.astro';
import TextAreaInput from '@components/ui/forms/input/TextAreaInput.astro';
import { SITE } from '@data/constants';

const pageTitle = `Contact | ${SITE.title}`;
// Public Web3Forms access key (safe to expose; ties to Mark's inbox server-side).
const WEB3FORMS_KEY = 'c1026f87-1484-43de-be7d-b63900f98a20';

const iconWrap =
  'flex h-12 w-12 shrink-0 items-center justify-center rounded-lg border border-hairline text-accent';
---

<MainLayout
  title={pageTitle}
  customDescription="Get in touch with Cloud Architecture. Questions, corrections, or a control you'd like covered."
>
  <section class="mx-auto max-w-[85rem] px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="mx-auto max-w-2xl lg:max-w-5xl">
      <div class="text-center">
        <p
          class="mb-3 font-mono text-xs font-semibold tracking-[0.16em] text-accent uppercase"
        >
          Get in touch
        </p>
        <h1
          class="text-4xl font-bold tracking-tight text-balance text-primary md:text-5xl"
        >
          Contact
        </h1>
        <p class="mt-3 text-lg text-pretty text-primary">
          Questions, corrections, or a control you'd like covered. Send it over,
          I read everything.
        </p>
      </div>

      <div class="mt-12 grid items-start gap-10 lg:grid-cols-2 lg:gap-16">
        {/* Form card */}
        <div
          class="flex flex-col rounded-2xl border border-hairline bg-card p-4 sm:p-6 lg:p-8"
        >
          <h2 class="mb-6 text-xl font-bold text-primary">
            Send a message
          </h2>
          <form id="contact-form">
            <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
            <input
              type="hidden"
              name="subject"
              value="New message from cloud-architecture.co.uk"
            />
            <input
              type="checkbox"
              name="botcheck"
              class="hidden"
              style="display:none"
              tabindex="-1"
              autocomplete="off"
            />
            <div class="grid gap-4">
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <TextInput id="c-first" name="first_name" label="First name" />
                <TextInput id="c-last" name="last_name" label="Last name" />
              </div>
              <EmailInput id="c-email" errorId="c-email-error" />
              <TextAreaInput id="c-message" name="message" label="Message" />
            </div>
            <div class="mt-4 flex justify-center sm:justify-start">
              <div
                class="h-captcha"
                data-sitekey="50b2fe65-b00b-4b9e-ad62-3ba471098be2"
              >
              </div>
            </div>
            <div class="mt-5">
              <button
                type="submit"
                class="inline-flex w-full items-center justify-center gap-x-2 rounded-lg bg-blue-600 px-4 py-3 text-sm font-bold text-white transition duration-300 hover:bg-blue-700 disabled:pointer-events-none disabled:opacity-60"
              >
                Send message
              </button>
            </div>
            <p
              id="contact-status"
              class="mt-3 text-center text-sm text-secondary"
              role="status"
            >
              I'll get back to you within a day or two.
            </p>
          </form>
        </div>

        {/* Contact info */}
        <div class="divide-y divide-hairline">
          <ContactIconBlock
            heading="Email"
            content="Prefer email? Drop me a line and I'll get back to you."
            isLinkVisible={true}
            linkTitle="contact@cloud-architecture.co.uk"
            linkURL="mailto:contact@cloud-architecture.co.uk"
            isArrowVisible={true}
          >
            <span class={iconWrap}>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
              </svg>
            </span>
          </ContactIconBlock>

          <ContactIconBlock
            heading="Connect on LinkedIn"
            content="Prefer LinkedIn? Reach out and say hello."
            isLinkVisible={true}
            linkTitle="Mark Hughes on LinkedIn"
            linkURL="https://www.linkedin.com/in/markdhughes91/"
            isArrowVisible={true}
          >
            <span class={iconWrap}>
              <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            </span>
          </ContactIconBlock>

          <ContactIconBlock
            heading="Request a topic"
            content="Open an issue on GitHub with the control you're trying to secure, and it may become a guide or script."
            isLinkVisible={true}
            linkTitle="Open an issue on GitHub"
            linkURL="https://github.com/Cloud-Architecture-UK"
            isArrowVisible={true}
          >
            <span class={iconWrap}>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 0 1-.923 1.785A5.969 5.969 0 0 0 6 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337Z" />
              </svg>
            </span>
          </ContactIconBlock>

          <ContactIconBlock
            heading="Read the guides"
            content="Browse the Microsoft 365 and Azure hardening guides, each done in full and ready to apply."
            isLinkVisible={true}
            linkTitle="Go to the blog"
            linkURL="/blog"
            isArrowVisible={true}
          >
            <span class={iconWrap}>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
              </svg>
            </span>
          </ContactIconBlock>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script src="https://js.hcaptcha.com/1/api.js" async defer></script>
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;
    const data = new FormData(form);
    if (!data.get('h-captcha-response')) {
      status.textContent = 'Please complete the captcha first.';
      status.className = 'mt-3 text-center text-sm text-red-600';
      return;
    }
    status.textContent = 'Sending…';
    status.className = 'mt-3 text-center text-sm text-secondary';
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: data,
      });
      const json = await res.json();
      if (json.success) {
        form.reset();
        status.textContent = 'Thanks, message sent.';
        status.className = 'mt-3 text-center text-sm text-accent';
      } else {
        throw new Error(json.message || 'failed');
      }
    } catch {
      status.textContent = 'Something went wrong. Please try again.';
      status.className = 'mt-3 text-center text-sm text-red-600';
    } finally {
      (window as any).hcaptcha?.reset();
    }
  });
</script>
