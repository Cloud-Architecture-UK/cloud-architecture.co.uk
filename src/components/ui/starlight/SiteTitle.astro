---
import docsLogo from '@images/starlight/docs_logo.svg?raw';
import type { Props } from '@astrojs/starlight/props';

const main = '/';
const locale = Astro.props.locale ? Astro.props.locale + '/' : '';
const docs = '/' + locale + 'docs/';
---

<span class="site-title flex">
  <a class="main-logo" href={main} aria-label="Cloud Architecture">
    <svg
      viewBox="0 0 40 40"
      width="26"
      height="26"
      fill="none"
      aria-hidden="true"
      style="position: relative; top: 3px;"
    >
      <path
        d="M10.4 22h19.2a6 6 0 0 0 .84-11.95A9 9 0 0 0 12.32 11.32 5.64 5.64 0 0 0 10.4 22Z"
        style="stroke: var(--sl-color-white);"
        stroke-width="3.2"
        stroke-linejoin="round"></path>
      <path
        d="M10.45 29h9"
        style="stroke: var(--sl-color-white);"
        stroke-width="3.6"
        stroke-linecap="round"></path>
      <path d="M23.45 29h9" stroke="#008080" stroke-width="3.6" stroke-linecap="round"
      ></path>
    </svg>
    <span class="wordmark"><b>Cloud</b> Architecture</span>
  </a>
  <a
    class="docs-logo"
    href={docs}
    set:html={docsLogo}
    aria-label="Cloud Architecture Docs"
  />
</span>

<style>
  .site-title {
    gap: 1rem;
    margin-right: 1rem;
  }
  .site-title a {
    display: flex;
  }

  .main-logo {
    align-items: center;
    gap: 0.55rem;
    font-weight: 400;
    font-size: 1.125rem;
    letter-spacing: -0.03em;
    white-space: nowrap;
    color: var(--sl-color-white);
  }
  .main-logo .wordmark b {
    font-weight: 700;
  }

  .flex {
    display: flex;
    align-items: center;
  }
  .site-title a:focus-visible {
    outline: 0;
  }
  .site-title a:focus-visible > :global(*) {
    transform: translateY(calc(0.1rem * -1));
    transition: transform 250ms cubic-bezier(0.33, 1, 0.68, 1);
  }

  .site-title :global(svg) {
    width: auto;
    height: auto;
  }
  .site-title a:hover :global(svg) {
    transform: translateY(calc(0.1rem * -1));
    transition: transform 250ms cubic-bezier(0.33, 1, 0.68, 1);
  }
</style>
