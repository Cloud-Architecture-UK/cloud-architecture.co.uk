---
// A linked docs landing card with a teal brand icon, for the /docs/ overview.
import { Icon } from '@astrojs/starlight/components';

interface Props {
  title: string;
  href: string;
  icon: string;
}
const { title, href, icon } = Astro.props;
---

<a class="doc-card" href={href}>
  <span class="doc-card__icon"><Icon name={icon} size="1.4rem" /></span>
  <span class="doc-card__body">
    <span class="doc-card__title">{title}</span>
    <span class="doc-card__desc"><slot /></span>
  </span>
</a>

<style>
  .doc-card {
    align-items: flex-start;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    color: var(--sl-color-white);
    display: flex;
    gap: 0.85rem;
    height: 100%;
    padding: 1rem 1.1rem;
    text-decoration: none;
    transition: border-color 200ms ease;
  }
  .doc-card:hover {
    border-color: var(--sl-color-accent);
  }
  .doc-card__icon {
    color: var(--sl-color-accent);
    flex: none;
    margin-top: 0.15rem;
  }
  .doc-card__title {
    display: block;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .doc-card__desc {
    color: var(--sl-color-gray-2);
    font-size: 0.9rem;
    line-height: 1.4;
  }
</style>
